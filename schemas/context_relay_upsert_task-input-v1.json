{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "else": {
    "properties": {
      "expectedRevision": {
        "type": "null"
      }
    }
  },
  "if": {
    "properties": {
      "taskId": {
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
        "type": "string"
      }
    },
    "required": [
      "taskId"
    ]
  },
  "properties": {
    "bodyMarkdown": {
      "maxLength": 1048576,
      "minLength": 1,
      "pattern": ".*\\S.*",
      "type": "string",
      "x-utf8-maxBytes": 1048576
    },
    "expectedRevision": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "type": "string"
        }
      ]
    },
    "operationId": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "status": {
      "enum": [
        "open",
        "in_progress",
        "blocked",
        "canceled"
      ]
    },
    "taskId": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "type": "string"
        }
      ]
    },
    "title": {
      "maxLength": 512,
      "minLength": 1,
      "pattern": ".*\\S.*",
      "type": "string",
      "x-utf8-maxBytes": 512
    }
  },
  "required": [
    "operationId",
    "title",
    "bodyMarkdown",
    "status"
  ],
  "then": {
    "properties": {
      "expectedRevision": {
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
        "type": "string"
      }
    },
    "required": [
      "expectedRevision"
    ]
  },
  "type": "object"
}
