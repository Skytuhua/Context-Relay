{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "cursor": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "maxLength": 256,
          "minLength": 1,
          "pattern": ".*\\S.*",
          "type": "string",
          "x-utf8-maxBytes": 256
        }
      ]
    },
    "status": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "enum": [
            "open",
            "in_progress",
            "blocked",
            "done",
            "canceled"
          ]
        }
      ]
    }
  },
  "required": [],
  "type": "object"
}
